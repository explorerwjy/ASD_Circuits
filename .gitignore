# 1. Ignore everything by default
*

# 2. But don't ignore directories (otherwise Git won't look inside them for files)
!*/

# 3. Whitelist your specific file types
!*.py
!*.ipynb
!*.yaml
!*.md
!*.txt
!.gitignore
!.gitkeep

# 4. Data and pipeline outputs are never tracked. The extension whitelist above
#    applies at every directory level, so without these rules the .txt/.yaml
#    files written by the SA / bootstrap / sibling pipelines show up untracked.
dat/
results/
.ipynb_checkpoints/

# 5. Explicitly ignore Mac system files (the .DS_Store files in your status)
.DS_Store
._*
.snakemake/
.vscode/
__pycache__/

# Ignore specific directory names everywhere in the project
**/archive/
**/draft/
**/drafts/

# docs/ tracks prose only (.md via the whitelist above), so design docs and plans
# are visible in the repo and from Claude Code remote. The manuscript tree stays
# ignored: it is ~227 MB of .docx drafts and copyrighted PDF reprints.
docs/MS/

# Validation and test files (not for publication)
notebook_validation/
scripts/test_*.py

# Legacy rebuttal notebooks (migrated to notebooks_mouse_str/)
notebook_rebuttal/*
!notebook_rebuttal/SplitHalf_Correlation.py
!notebook_rebuttal/SplitHalf_Correlation.ipynb

# Astro agent directory
.astro/
